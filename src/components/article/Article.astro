---
import { unixTimestampToMonthYear } from '../../utils'
import H1 from './H1.astro'
import InPageNavigation from './InPageNavigation'

type Props = {
  slug: string
  title: string
  published: number
  readingTime: number
  headings: string[]
}

const { slug, title, published, readingTime, headings } = Astro.props
---

<article class="mx-auto w-full max-w-7xl justify-between px-4 lg:flex lg:px-8">
  <div class="max-w-2xl xl:max-w-3xl">
    <div class="pt-12 pb-6">
      <H1>{title}</H1>
      <p class="mt-3 text-sm text-gray-400">
        {unixTimestampToMonthYear(published)} · {readingTime} min read
      </p>
    </div>
    <div class="-mt-6 pb-24 md:text-lg">
      <slot />
    </div>
  </div>
  <InPageNavigation client:load slug={slug} title={title} headings={headings} />
</article>
