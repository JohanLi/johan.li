---
/*
  The React version rendered each child in its own <blockquote> when given
  several children. Astro slots can't be split up like that, so to get
  several quotes in a row, use several <BlockQuote>s.
 */
---

<blockquote class="my-12 border-l-4 border-gray-200 pl-4">
  <slot />
</blockquote>
