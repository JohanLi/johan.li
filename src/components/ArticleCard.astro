---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { unixTimestampToMonthYear } from '../utils'

// an article's frontmatter, see src/content.config.ts
type Props = CollectionEntry<'articles'>['data'] & {
  slug: string
}

const { slug, thumbnail, title, teaser, published, readingTime } = Astro.props

/*
  image() in the collection schema always provides a format, but Astro's types
  infer it as optional, which <Image> doesn't accept.
 */
const thumbnailImage = thumbnail as ImageMetadata

/*
  PNG thumbnails are usually pixel art with few colors, which compresses well
  as-is. Converting to WebP or resizing blends pixels into new colors, which
  makes the image both blurrier and several times larger, so PNGs are served at
  their original size.
 */
const isPng = thumbnailImage.format === 'png'
---

<a
  href={`/${slug}`}
  class="flex transform flex-col overflow-hidden rounded-lg shadow-lg transition duration-200 hover:scale-105"
>
  <Image
    src={thumbnailImage}
    alt={title}
    class="h-48 w-full object-cover"
    format={isPng ? 'png' : 'webp'}
    widths={isPng ? [thumbnailImage.width] : [480, 960, 1280]}
    sizes="(min-width: 1280px) 400px, (min-width: 640px) 50vw, 100vw"
  />
  <div class="flex flex-1 flex-col p-6">
    <div class="flex-1">
      <h2 class="text-xl font-semibold text-gray-900">{title}</h2>
      <div class="mt-3 text-gray-500">{teaser}</div>
    </div>
    <div class="mt-6 text-sm text-gray-500">
      {unixTimestampToMonthYear(published)} · {readingTime} min read
    </div>
  </div>
</a>
