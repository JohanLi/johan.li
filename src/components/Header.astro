---
type Props = {
  isHomePage: boolean
}

const { isHomePage } = Astro.props
---

{isHomePage ? (
  <a
    href="/"
    class="inline-block text-4xl font-extrabold tracking-tight text-[#a675a2] md:text-5xl"
  >
    <h1>Johan Li</h1>
  </a>
) : (
  <a
    href="/"
    class="text-2xl font-extrabold tracking-tight text-[#a675a2] md:text-3xl"
  >
    <h2>Johan Li</h2>
  </a>
)}
