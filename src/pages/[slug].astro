---
import { render } from 'astro:content'

import { getArticles } from '../articles/getArticles'
import Link from '../components/Link.astro'
import Article from '../components/article/Article.astro'
import { H2, H3, Ol, P, Ul } from '../components/article/Common'
import Blog from '../layouts/Blog.astro'

export async function getStaticPaths() {
  const articles = await getArticles()

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }))
}

const { article } = Astro.props
const { Content, headings } = await render(article)
---

<Blog title={article.data.title} description={article.data.teaser}>
  <Article
    slug={article.id}
    title={article.data.title}
    published={article.data.published}
    readingTime={article.data.readingTime}
    headings={headings
      .filter((heading) => heading.depth === 2)
      .map((heading) => heading.text)}
  >
    <Content components={{ p: P, h2: H2, h3: H3, a: Link, ul: Ul, ol: Ol }} />
  </Article>
</Blog>
