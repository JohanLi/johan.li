---
import { getArticles } from '../articles/getArticles'
import ArticleCard from '../components/ArticleCard.astro'
import Intro from '../components/intro/Intro.astro'
import Blog from '../layouts/Blog.astro'

const articles = getArticles()
---

<Blog>
  <div class="mx-auto max-w-7xl space-y-12 px-4 pt-6 pb-12 sm:pt-12 sm:pb-24 lg:px-8">
    <Intro />
    <div>
      <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 md:text-3xl">
        Articles
      </h2>
      <div class="mt-6 mb-12 grid gap-12 sm:mt-12 sm:mb-24 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard {...article} />
        ))}
      </div>
    </div>
  </div>
</Blog>
