    "preact": "^11.0.1",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.10.0",
    "@types/prismjs": "^1.26.5",
    "eslint": "^10.12.0",
